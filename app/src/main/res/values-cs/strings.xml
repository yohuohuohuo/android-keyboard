    <string name="help">Nápověda</string>
    <string name="help_select_device_from_list">Vyberte zařízení, které si přejete ovládat ze seznamu spárovaných zařízení.</string>
    <string name="help_missing_device_title">Zařízení nevidím</string>
    <string name="help_missing_device_message">Jestliže se zařízení nenachází v seznamu spárovaných zařízení, je třeba jej spárovat stiknutím ikony Bluetooth v horní liště.</string>
    <string name="help_device_failed_connection_title">Připojení selhalo</string>
    <string name="help_device_failed_connection_message_1">Pokud se nejste schopni připojit k zařízení, řiďtě se prosím následujícími pokyny:</string>
    <string name="help_device_failed_connection_check_1">• Ujistěte se, že na vzdáleném zařízení běží Android nebo macOS/iOS/iPadOS/tvOS/Windows/Linux.</string>
    <string name="help_device_failed_connection_check_2">• Ujistěte se, že na vzdáleném zařízení je zapnuto Bluetooth.</string>
    <string name="help_device_failed_connection_check_3">• Ujistěte se, že zařízení je v dosahu.</string>
    <string name="help_device_failed_connection_check_4">• Zkuste se připojit vícekrát.</string>
    <string name="help_device_failed_connection_message_2">Pokud problém stále přetrvává, postupujte následovně:</string>
    <string name="help_device_failed_connection_check_5">• Zrušte párování zařízení, a to jak na tomto zařízení, tak na vzdáleném zařázení.</string>
    <string name="help_device_failed_connection_check_6">• Znovu spárujte vzdálené zařízení kliknutím na ikonu Bluetooth v horní liště.</string>
    <string name="help_device_failed_connection_message_3">Pokud problém i nadále přetrvává, ujistěte se, že snímač Bluetooth na vašich zařízeních není vadný.</string>
    <string name="help_paring_select_device_from_list">Vyberte zařízení, které chcete spárovat ze seznamu dostupných zařízení:</string>
    <string name="help_pairing_missing_device_message_1">Pokud se zařízení, které se snažíte spárovat, nezobrazuje, postupujte podle následujích intrukcí:</string>
    <string name="help_pairing_missing_device_check_2">• Ujistěte se, že je vzdálené zařízení viditělné.</string>
    <string name="help_pairing_missing_device_check_location_for_android_11_or_less">• Ujistěte se, že jsou povoleny služby pro získávání polohy na tomto zařízení.</string>
    <string name="help_pairing_device_failed_connection_message_1">Pokud jste úspěšně spárovali obě zařízení, ale nejste schopni se připojit, postupujte podle následujích intrukcí:</string>
    <string name="help_remote_control_buttons_are_not_working_title">Tlačítka ovládání</string>
    <string name="help_remote_control_buttons_are_not_working_message">Pokud klávesnice, myš, nebo něktěrá tlačítka nefungují, postupujte podle následujích intrukcí:</string>
    <string name="help_remote_control_buttons_are_not_working_check_2">• Odpojte se od vzdáleného zařízení.</string>
    <string name="help_remote_control_buttons_are_not_working_check_3">• Zrušte párování zařízení, a to jak na tomto zařízení, tak na vzdáleném zařázení.</string>
    <string name="help_remote_control_buttons_are_not_working_check_4">• Znovu spárujte zařízení za použití této aplikace.</string>
    <string name="help_keyboard_wrong_character_sent_message">Pokud zadávané znaky neodpovídají těm zadaným, musíte nastavit fyzickou klávesnici na vzdáleném zařízení tak, aby odpovídala klávesnici zvolené v nastavení.</string>
