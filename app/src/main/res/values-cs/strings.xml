    <string name="pairing_from_the_remote_device">Párování ze vzdáleného zařízení</string>
    <string name="name_of_this_device">Název tohoto zařízení: %1$s.</string>
    <string name="pairing_from_a_remote_device_intro_title">Průvodce párováním ze vzdáleného zařízení</string>
    <string name="pairing_from_a_remote_device_intro_content">Na některých zařízeních může být vypnutá viditelnost Bluetooth, což aplikaci brání v jejich nalezení. Tento průvodce vám pomůže problém vyřešit a vysvětlí, jak zařízení spárovat přímo ze vzdáleného zařízení.</string>
    <string name="pairing_from_a_remote_device_step_1_title">1. Zapněte viditelnost Bluetooth</string>
    <string name="pairing_from_a_remote_device_step_1_content_1">Nejprve musíte na tomto zařízení zapnout viditelnost Bluetooth.</string>
    <string name="pairing_from_a_remote_device_step_1_content_2">Toto zařízení by mělo být pro ostatní zařízení viditelné pod názvem: %1$s.</string>
    <string name="enabled_bluetooth_visibility">Viditelnost Bluetooth je zapnutá</string>
    <string name="pairing_from_a_remote_device_step_2_title">2. Spárujte obě zařízení</string>
    <string name="pairing_from_a_remote_device_step_2_content_1">Na vzdáleném zařízení:</string>
    <string name="pairing_from_a_remote_device_step_2_content_2">- Otevřete nastavení Bluetooth.\n- Vyberte možnost spárování nového zařízení.\n- Zařízení „%1$s“ by se mělo zobrazit v seznamu dostupných zařízení.\n- Vyberte zařízení „%1$s“ a zahajte párování.</string>
    <string name="pairing_from_a_remote_device_step_2_content_3">Na obou zařízeních by se měla zobrazit žádost o potvrzení párování. Pro dokončení párování Bluetooth ji musíte přijmout na obou zařízeních.</string>
    <string name="pairing_from_a_remote_device_step_2_content_4">Pokud se žádná žádost o potvrzení nezobrazí, restartujte Bluetooth na vzdáleném zařízení a zopakujte předchozí kroky.</string>
    <string name="pairing_from_a_remote_device_step_3_title">3. Odpojte zařízení</string>
    <string name="pairing_from_a_remote_device_step_3_content_1">Pokud párování proběhlo úspěšně, zařízení s Androidem by se mělo automaticky připojit ke vzdálenému zařízení. Toto připojení však nepoužívá protokol HID (Human Interface Device), což brání fungování dálkového ovládání. Pro vyřešení problému:</string>
    <string name="pairing_from_a_remote_device_step_3_content_2">- Přejděte do nastavení Bluetooth na svém zařízení.\n- Ručně odpojte vzdálené zařízení.</string>
    <string name="open_bluetooth_settings">Otevřít nastavení Bluetooth</string>
    <string name="pairing_from_a_remote_device_step_4_title">4. Dokončení</string>
    <string name="pairing_from_a_remote_device_step_4_content">Pokud jste provedli všechny předchozí kroky, párování proběhlo úspěšně a obě zařízení jste odpojili, můžete vybrat tlačítko „%1$s“. Vzdálené zařízení by se mělo zobrazit v seznamu spárovaných zařízení. Vyberte jej a vytvořte připojení pomocí protokolu HID.</string>
