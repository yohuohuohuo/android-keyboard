    <string name="help">Hjælp</string>
    <string name="help_select_device_from_list">Vælg den enhed, du vil oprette forbindelse til, på listen over parrede enheder.</string>
    <string name="help_missing_device_title">Manglende enhed</string>
    <string name="help_missing_device_message">Hvis den anden enhed ikke vises på listen over parrede enheder, skal du parre den ved at trykke på ikonet i den øverste bjælke.</string>
    <string name="help_device_failed_connection_title">Forbindelsen mislykkedes</string>
    <string name="help_device_failed_connection_message_1">Hvis du ikke kan oprette forbindelse til den anden enhed, skal du følge vejledningen nedenfor:</string>
    <string name="help_device_failed_connection_check_1">• Kontrollér, at den anden enhed bruger Android eller macOS/iOS/iPadOS/tvOS/Windows/Linux.</string>
    <string name="help_device_failed_connection_check_2">• Kontrollér, at Bluetooth er aktiveret på den anden enhed.</string>
    <string name="help_device_failed_connection_check_3">• Kontrollér, at enhederne er tæt nok på hinanden.</string>
    <string name="help_device_failed_connection_check_4">• Prøv at oprette forbindelse flere gange.</string>
    <string name="help_device_failed_connection_message_2">Hvis du stadig ikke kan oprette forbindelse til den anden enhed efter disse kontroller, skal du gøre følgende:</string>
    <string name="help_device_failed_connection_check_5">• Ophæv parringen på både denne enhed og den anden enhed.</string>
    <string name="help_device_failed_connection_check_6">• Par de to enheder igen ved at trykke på ikonet i den øverste bjælke.</string>
    <string name="help_device_failed_connection_message_3">Hvis problemet fortsætter, skal du kontrollere, at enhedernes Bluetooth-hardware ikke er defekt.</string>
    <string name="help_paring_select_device_from_list">Vælg den enhed, du vil parre med, på listen over tilgængelige enheder.</string>
    <string name="help_pairing_missing_device_message_1">Hvis den enhed, du vil parre med, ikke vises, skal du følge vejledningen nedenfor:</string>
    <string name="help_pairing_missing_device_check_2">• Kontrollér, at den anden enhed er synlig via Bluetooth.</string>
    <string name="help_pairing_missing_device_check_location_for_android_11_or_less">• Kontrollér, at placeringstjenester er aktiveret på din enhed.</string>
    <string name="help_pairing_device_failed_connection_message_1">Hvis du har parret begge enheder, men ikke kan oprette forbindelse til den anden enhed, skal du følge vejledningen nedenfor:</string>
    <string name="help_remote_control_buttons_are_not_working_title">Fjernbetjeningsknapper</string>
    <string name="help_remote_control_buttons_are_not_working_message">Hvis tastaturet, musen eller nogle af knapperne ikke virker, skal du følge vejledningen nedenfor:</string>
    <string name="help_remote_control_buttons_are_not_working_check_2">• Afbryd forbindelsen til den anden enhed.</string>
    <string name="help_remote_control_buttons_are_not_working_check_3">• Ophæv parringen på både denne enhed og den anden enhed.</string>
    <string name="help_remote_control_buttons_are_not_working_check_4">• Par derefter de to enheder igen med denne app.</string>
    <string name="help_remote_control_buttons_are_not_working_message_2">Apps, der bruger HID-protokollen, kan bruge forskellige profiler. Hvis du tidligere har parret enhederne med en anden app, kan du være nødt til at parre dem igen for at nulstille profilen. Uden dette trin virker knapperne måske ikke som forventet eller sender forkerte værdier.</string>
    <string name="help_keyboard_wrong_character_sent_message">Hvis de sendte tegn er forkerte, skal du indstille det fysiske tastatur på den anden enhed til det sprog, du har valgt i appens indstillinger.</string>
    <string name="help_hid_service_not_initialized_title">HID-tjenesten er ikke initialiseret</string>
    <string name="help_hid_service_not_initialized_message_1">Hvis en meddelelse angiver, at HID-tjenesten ikke er initialiseret, skal du åbne enhedens udviklerindstillinger og finde indstillingen \"Deaktivér Bluetooth HID-enhedsprofil\":</string>
    <string name="help_hid_service_not_initialized_message_2">• Hvis indstillingen findes, skal du deaktivere den og derefter genstarte enheden. Efter genstart bør HID-profilen fungere normalt.</string>
    <string name="help_hid_service_not_initialized_message_3">• Hvis indstillingen ikke findes, understøtter din enhed muligvis ikke HID-profilen. I så fald kan du desværre ikke bruge denne app på enheden.</string>
</resources>
